{
  "name": "wallant-trading-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:masking": "playwright test --config playwright.masking.config.ts",
    "test:e2e:planning": "playwright test --config playwright.planning.config.ts",
    "test:e2e:deployed:readonly": "npm run build && playwright test --config playwright.deployed.config.ts && node ./e2e-deployed/verify-sanitized-evidence.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.15.30",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
