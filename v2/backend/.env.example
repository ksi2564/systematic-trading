WALLANT_ENVIRONMENT=local
WALLANT_DATABASE_URL=mysql+pymysql://wallant:change-me@127.0.0.1:3307/wallant_v2
WALLANT_PARQUET_ROOT=./data/market
WALLANT_EXECUTION_ENABLED=false
WALLANT_BROKER_ADAPTER=disabled

# CredentialCipher.generate_key()로 만든 URL-safe base64 32바이트 키
WALLANT_CREDENTIAL_MASTER_KEY=

# 운영 Cloudflare Access
WALLANT_ALLOWED_ACCESS_EMAILS=["owner@example.com"]

# Discord outbound Gateway. 비활성 상태에서는 토큰이 필요 없다.
WALLANT_DISCORD_ENABLED=false
WALLANT_DISCORD_BOT_TOKEN=
WALLANT_DISCORD_GUILD_ID=
WALLANT_DISCORD_CHANNEL_ID=
WALLANT_DISCORD_ALLOWED_USER_IDS=[]
