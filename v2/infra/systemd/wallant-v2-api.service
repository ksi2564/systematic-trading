[Unit]
Description=Wall-Ant v2 FastAPI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=wallant
Group=wallant
WorkingDirectory=/opt/wallant/current/v2/backend
EnvironmentFile=/etc/wallant/v2.env
ExecStart=/opt/wallant/current/venv/bin/python -m uvicorn wallant.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
MemoryHigh=384M
MemoryMax=512M
CPUQuota=100%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wallant /var/log/wallant
UMask=0077

[Install]
WantedBy=multi-user.target
